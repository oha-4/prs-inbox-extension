---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import { REPO_URL, type Lang, ui } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Lang;
}

const { title, description, lang } = Astro.props;
const t = ui[lang];

// 現在ページの base・ロケール抜きサブパス（hreflang と言語トグルが同一ページを指すように）
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const subpath = Astro.url.pathname
  .slice(Astro.url.pathname.startsWith(base) ? base.length : 0)
  .replace(/^\/(en|ja)(?=\/|$)/, '')
  .replace(/^\//, '');

const otherLang: Lang = lang === 'en' ? 'ja' : 'en';
const favicon = `${base}/favicon.png`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={favicon} />
    <link rel="alternate" hreflang="en" href={getAbsoluteLocaleUrl('en', subpath)} />
    <link rel="alternate" hreflang="ja" href={getAbsoluteLocaleUrl('ja', subpath)} />
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', subpath)} />
    <link rel="canonical" href={getAbsoluteLocaleUrl(lang, subpath)} />
  </head>
  <body>
    <div class="mx-auto flex min-h-screen max-w-4xl flex-col px-5 sm:px-8">
      <header class="flex items-center justify-between gap-4 py-6">
        <a
          href={getRelativeLocaleUrl(lang, '')}
          class="flex items-center gap-2.5 no-underline hover:opacity-80"
        >
          <span class="signal-led bg-signal size-2.5 shrink-0 rounded-full" aria-hidden="true"
          ></span>
          <span class="font-display text-base font-semibold tracking-tight">{t.siteName}</span>
        </a>
        <nav class="text-muted-foreground flex items-center gap-5 text-sm">
          <a href={REPO_URL} class="hover:text-foreground" rel="noopener">{t.nav.github}</a>
          <a
            href={getRelativeLocaleUrl(otherLang, subpath)}
            class="font-mono hover:text-foreground text-xs tracking-wide"
            lang={otherLang}>{t.nav.langSwitch}</a
          >
        </nav>
      </header>

      <main class="flex-1 pb-16">
        <slot />
      </main>

      <footer class="border-t py-8 text-sm">
        <nav class="text-muted-foreground flex flex-wrap items-center gap-x-5 gap-y-2">
          <a href={getRelativeLocaleUrl(lang, 'terms')} class="hover:text-foreground"
            >{t.footer.terms}</a
          >
          <a href={getRelativeLocaleUrl(lang, 'privacy')} class="hover:text-foreground"
            >{t.footer.privacy}</a
          >
          <a href={REPO_URL} class="hover:text-foreground" rel="noopener">GitHub</a>
          <a href={`${REPO_URL}/blob/main/LICENSE`} class="hover:text-foreground" rel="noopener"
            >{t.footer.license}</a
          >
        </nav>
        <p class="text-muted-foreground/80 mt-4 text-xs leading-relaxed">{t.footer.disclaimer}</p>
      </footer>
    </div>
  </body>
</html>
